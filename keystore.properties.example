# Keystore Release Signing Configuration (Example Template)
# Salin file ini menjadi 'keystore.properties' dan isi dengan kredensial asli Anda.

# Path to keystore file relative to project root or absolute path
storeFile=my-release-key.jks

# Keystore password
storePassword=YOUR_KEYSTORE_PASSWORD

# Key alias inside the keystore
keyAlias=YOUR_KEY_ALIAS

# Key password
keyPassword=YOUR_KEY_PASSWORD
